---
import ArrowRightIcon from "../icons/ArrowRightIcon.astro"

const { title, text, image, path } = Astro.props;
---
<article class="service-card glass">
    <div class="media">
        <img src={image} alt={`${title} – ilustrační obrázek`} width="600" height="400" loading="lazy" decoding="async">
    </div>
    <div class="body">
        <h3>{title}</h3>
        <p>{text}</p>
        <a href={`/sluzby/${path}`} class="more" aria-label={`Více o službě ${title}`}>
            Více
            <span class="more-icon"><ArrowRightIcon/></span>
        </a>
    </div>
</article>
<style>
    .service-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 10px;
        border-radius: 28px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .service-card:hover {
        transform: translateY(-4px);
        box-shadow:
            0 32px 70px -28px rgba(5, 94, 105, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .media {
        overflow: hidden;
        border-radius: 20px;
    }
    img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .service-card:hover img {
        transform: scale(1.05);
    }
    .body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 22px 14px 12px;
    }
    h3 {
        color: var(--green-dark);
        font-size: 1.45rem;
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 12px;
    }
    p {
        color: var(--text-body);
        font-size: 1rem;
        line-height: 1.6;
        margin: 0 0 20px;
    }
    .more {
        display: inline-flex;
        text-decoration: none;
        align-items: center;
        gap: 10px;
        width: fit-content;
        margin-top: auto;
        padding: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--green-dark);
        cursor: pointer;
    }
    /* Make the whole card clickable */
    .more::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 28px;
    }
    .more:hover {
        color: var(--green-dark);
    }
    .more:focus-visible {
        outline: none;
    }
    .service-card:has(.more:focus-visible) {
        outline: 3px solid var(--green-dark);
        outline-offset: 3px;
    }
    .more-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--salmon-light);
        color: var(--salmon-darker);
        transition: transform 0.25s ease;
    }
    .more-icon :global(svg) {
        height: 17px;
    }
    .service-card:hover .more-icon {
        transform: translateX(4px);
    }

    @media (prefers-reduced-motion: reduce) {
        .service-card,
        img,
        .more-icon {
            transition: none;
        }
    }
</style>
