---
import SectionHeading from "../SectionHeading.astro"

const logos = [
    { src: "/pojistovny/zps.webp", alt: "Logo Zdravotní pojišťovny Škoda", width: 978, height: 978, size: "zps" },
    { src: "/pojistovny/zpmv.webp", alt: "Logo Zdravotní pojišťovny ministerstva vnitra ČR", width: 1129, height: 855, size: "zpmv" },
    { src: "/pojistovny/vozp.webp", alt: "Logo Vojenské zdravotní pojišťovny ČR", width: 289, height: 168, size: "vozp" },
    { src: "/pojistovny/ozp.webp", alt: "Logo Oborové zdravotní pojišťovny", width: 1840, height: 668, size: "ozp" },
]
---
<section id="insurance-companies" aria-labelledby="insurance-title">
    <SectionHeading size="md" id="insurance-title">Spolupracujeme:</SectionHeading>
    <ul class="logos">
        {logos.map(logo =>
            <li class="logo-tile">
                <img class={`logo logo-${logo.size}`} src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" decoding="async"/>
            </li>
        )}
    </ul>
</section>
<style>
    #insurance-companies {
        position: relative;
        max-width: 1240px;
        margin: 0 auto;
    }
    .logos {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    /* Logos ship on white boxes, so the tiles are solid white (not see-through glass) to keep them seamless */
    .logo-tile {
        display: grid;
        place-items: center;
        height: 136px;
        padding: 20px 28px;
        box-sizing: border-box;
        border-radius: 24px;
        background: #fff;
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
    }
    /* Per-logo heights so the four marks read at a similar optical size */
    .logo {
        display: block;
        width: auto;
        max-width: 100%;
        height: var(--logo-h);
        object-fit: contain;
    }
    .logo-zps { --logo-h: 84px; }
    .logo-zpmv { --logo-h: 70px; }
    .logo-vozp { --logo-h: 66px; }
    .logo-ozp { --logo-h: 48px; }

    @media (max-width: 850px) {
        .logos {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }
        .logo-tile {
            height: 120px;
        }
    }
    @media (max-width: 400px) {
        .logos {
            gap: 12px;
        }
        .logo-tile {
            height: 100px;
            padding: 16px;
            border-radius: 20px;
        }
        .logo-zps { --logo-h: 60px; }
        .logo-zpmv { --logo-h: 56px; }
        .logo-vozp { --logo-h: 48px; }
        .logo-ozp { --logo-h: 38px; }
    }
</style>
