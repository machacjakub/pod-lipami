---
import LocationIcon from "../icons/LocationIcon.astro"
import ReservationButton from "../ReservationButton.astro"
import BlobBackground from "../BlobBackground.astro"
---
<section id="hero-wrapper">
    <BlobBackground blobs={[
        { tone: "teal", size: 620, top: "-120px", right: "-80px", duration: 18 },
        { tone: "salmon", size: 520, bottom: "0", left: "-120px", duration: 22, reverse: true },
        { tone: "mint", size: 380, top: "35%", left: "38%", duration: 26 },
    ]}/>

    <div id="hero">
        <div class="hero-card glass">
            <span class="accent-line" aria-hidden="true"/>
            <h1>Fyzioterapie <span class="h1-accent">Pod Lipami</span></h1>
            <p class="subtitle"><LocationIcon/> Kosmonosy u Mladé Boleslavi</p>
            <ReservationButton href="#kontakt"/>
        </div>

        <div class="hero-media">
            <span class="stain" aria-hidden="true"/>
            <div class="photo-frame glass">
                <picture>
                    <source media="(min-width: 851px)" srcset="/new-hero.webp" width="1792" height="1195"/>
                    <img width="900" height="600" alt="Fyzioterapie pod Lipami v Kosmonosech – terapeut při ošetření pacienta" src="/new-hero-mobile.webp" loading="eager" fetchpriority="high" decoding="async"/>
                </picture>
            </div>
        </div>
    </div>
</section>
<style>
    #hero-wrapper {
        position: relative;
        overflow: clip;
        padding: 130px clamp(16px, 4vw, 48px) 80px;
        background: linear-gradient(180deg, white 0%, var(--background-lighter-blue) 45%, var(--background-lighter-blue) 70%, white 100%);
    }

    #hero {
        position: relative;
        max-width: 1240px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        align-items: center;
    }

    .hero-card {
        position: relative;
        z-index: 2;
        margin-right: -88px;
        padding: clamp(28px, 3.5vw, 52px);
        border-radius: 32px;
        animation: riseIn 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .accent-line {
        margin-bottom: 24px;
    }
    h1 {
        color: var(--green-dark);
        font-size: clamp(2.25rem, 1.4rem + 2.6vw, 4rem);
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0 0 18px;
    }
    .h1-accent {
        display: block;
        background: linear-gradient(90deg, var(--green-dark), #2f8f8a);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .subtitle {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #2f7f7a;
        font-size: clamp(1.1rem, 0.9rem + 0.6vw, 1.5rem);
        margin: 0 0 32px;
    }
    .subtitle :global(svg) {
        height: 1.2em;
        width: auto;
        flex-shrink: 0;
        color: var(--green-light);
    }

    .hero-media {
        position: relative;
    }
    .stain {
        position: absolute;
        width: 360px;
        height: 300px;
        top: -110px;
        right: -110px;
        background: linear-gradient(135deg, #7cbfd9, #a9d6e6);
        border-radius: 42% 58% 63% 37% / 45% 38% 62% 55%;
        filter: blur(42px);
        opacity: 0.95;
        animation: wobble 16s ease-in-out infinite alternate;
    }
    .photo-frame {
        position: relative;
        padding: 12px;
        border-radius: 40px;
    }
    .photo-frame picture {
        display: block;
        overflow: hidden;
        border-radius: 30px;
    }
    .photo-frame img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        animation: settle 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @media (max-width: 1150px) {
        #hero-wrapper {
            padding-top: 110px;
        }
        .hero-card {
            margin-right: -64px;
        }
        .stain {
            width: 280px;
            height: 240px;
            top: -80px;
            right: -70px;
        }
    }
    @media (max-width: 850px) {
        #hero-wrapper {
            padding: 90px 16px 40px;
        }
        #hero {
            grid-template-columns: minmax(0, 1fr);
        }
        .hero-media {
            order: -1;
        }
        .hero-card {
            margin: -44px 12px 0;
            border-radius: 28px;
        }
        .accent-line {
            margin-bottom: 18px;
        }
        .subtitle {
            margin-bottom: 24px;
        }
        .photo-frame {
            padding: 8px;
            border-radius: 30px;
        }
        .photo-frame picture {
            border-radius: 22px;
        }
        .stain {
            width: 220px;
            height: 180px;
            top: -50px;
            right: -40px;
            filter: blur(32px);
        }
    }
    @media (max-width: 400px) {
        .hero-card {
            margin-inline: 6px;
        }
    }

    @keyframes riseIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* No opacity change: the photo is the LCP element and must paint immediately */
    @keyframes settle {
        from {
            transform: scale(1.04);
        }
        to {
            transform: scale(1);
        }
    }
    @keyframes wobble {
        from {
            transform: rotate(0deg) scale(1);
        }
        to {
            transform: rotate(25deg) scale(1.12);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .stain,
        .hero-card,
        .photo-frame img {
            animation: none;
        }
    }
</style>
