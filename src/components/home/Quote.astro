---
---
<figure class="statement">
    <span class="mark" aria-hidden="true">&ldquo;</span>
    <p><slot/></p>
    <span class="rule" aria-hidden="true"/>
</figure>
<style>
    .statement {
        position: relative;
        max-width: 920px;
        margin: 0 auto;
        padding: 0 clamp(4px, 2vw, 24px);
        text-align: center;
    }
    .mark {
        display: block;
        height: 0.5em;
        margin: 0 auto 0.15em;
        font-size: clamp(5rem, 4rem + 3vw, 7.5rem);
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 700;
        line-height: 0.95;
        background: linear-gradient(135deg, var(--salmon-dark), var(--salmon-light));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        user-select: none;
    }
    p {
        margin: 0;
        color: var(--green-dark);
        font-size: clamp(1.35rem, 0.95rem + 1.25vw, 2.1rem);
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: -0.015em;
        text-wrap: balance;
    }
    .rule {
        display: block;
        width: 56px;
        height: 6px;
        margin: clamp(22px, 2.5vw, 32px) auto 0;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--salmon-dark), var(--salmon-light));
    }
</style>
